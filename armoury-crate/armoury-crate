    def refresh(self):
        profile = read_profile()
        # While a profile change is still propagating through PPD/TuneD to the
        # firmware (~1s), show what the user asked for instead of stale state.
        if self.pending_profile is not None:
            profile = self.pending_profile
        self.update_profile_styles(profile)
        limit = read_limit()
        shown_limit = f"{limit}%" if limit is not None else "Not available"
        self.battery_status_value.set_text(shown_limit)
        if limit is not None:
            if not self.limit_dirty:
                self.syncing_limit = True
                self.limit_scale.set_value(limit)
                self.syncing_limit = False
            self.limit_feedback.set_text(f"The system reports a {limit}% charge limit.")
        else:
            self.limit_feedback.set_text("No battery charge threshold was found. Check that asusctl and the ASUS kernel module are available.")
        hwmon = fan_hwmon()
        cpu = fan_read(hwmon, "fan1_input")
        gpu = fan_read(hwmon, "fan2_input")
        self.cpu_fan_value.set_text(rpm(cpu))
        self.gpu_fan_value.set_text(rpm(gpu))
        if hasattr(self, "mon"):
            cpu_temp = read_thermal("acpitz")
            gpu_temp = read_thermal("amdgpu")
            freq = cpu_freq_ghz()
            total_gb, free_gb, used_pct = disk_usage()
            cpu_val, cpu_bar = self.mon["CPU"]
            cpu_val.set_text(f"{cpu_temp:.0f} °C · {freq:.1f} GHz" if cpu_temp is not None else f"{freq:.1f} GHz")
            cpu_bar.set_value(min(100.0, cpu_temp or 0))
            gpu_val, gpu_bar = self.mon["GPU"]
            gpu_val.set_text(f"{gpu_temp:.0f} °C" if gpu_temp is not None else "—")
            gpu_bar.set_value(min(100.0, gpu_temp or 0))
            for key, speed in (("CPU_FAN", cpu), ("GPU_FAN", gpu)):
                fan_value, fan_bar = self.fan_mon[key]
                fan_value.set_text(rpm(speed))
                fan_bar.set_value(min(100.0, (speed or 0) / 60.0))
            storage_value, storage_bar = self.storage_mon["STORAGE"]
            storage_value.set_text(f"{free_gb:.0f} GB free · {used_pct:.0f}% used")
            storage_bar.set_value(used_pct)
            memory_total, memory_available = read_memory()
            if memory_total is not None and memory_available is not None:
                memory_used = memory_total - memory_available
                memory_value, memory_bar = self.storage_mon["RAM"]
                memory_percent = memory_used / memory_total * 100 if memory_total else 0
                memory_value.set_text(f"{memory_used / 1048576:.1f} / {memory_total / 1048576:.1f} GB")
                memory_bar.set_value(memory_percent)
            ssd_value, ssd_bar = self.storage_mon["SSD"]
            disk_models = read_disks()
            ssd_value.set_text(" · ".join(disk_models) if disk_models else "Unavailable")
            ssd_bar.set_value(used_pct)
        level = int_or_none(text("/sys/class/power_supply/BAT1/capacity", ""))
        status = text("/sys/class/power_supply/BAT1/status", "Battery status unavailable")
        self.battery_level_value.set_text(f"{level}%" if level is not None else "—")
        self.battery_level_card.get_last_child().set_text(status)
        brightness = int_or_none(text("/sys/class/leds/asus::kbd_backlight/brightness", ""))
        if brightness is not None:
            self.brightness_scale.set_value(brightness)
        gpu_mode = command(["supergfxctl", "-g"])
        self.gpu_current_value.set_text(gpu_mode.stdout.strip() if gpu_mode.returncode == 0 else "Unavailable")
        current_mode = gpu_mode.stdout.strip() if gpu_mode.returncode == 0 else None
        if current_mode in GPU_MODES:
            self.gpu_dropdown.set_selected(GPU_MODES.index(current_mode))
        device_name = pretty_product_name(text("/sys/class/dmi/id/product_name", "ASUS laptop"))
        if hasattr(self, "hero_device"):
            self.hero_device.set_text(device_name)
        connected = get_prop("PlatformProfile") is not None
        self.clock_status.set_text("●  SYSTEM CONNECTED" if connected else "●  SYSTEM UNAVAILABLE")
        if connected:
            self.clock_status.remove_css_class("off")
        else:
            self.clock_status.add_css_class("off")
        return True

    def refresh_timer(self):
        self.refresh()
        return GLib.SOURCE_CONTINUE

    def on_refresh(self, _button):
        self.refresh()
        self.toast("Status refreshed")

    def on_profile_clicked(self, _button, name):
        # Prefer the desktop power-profiles daemon so TuneD (which also owns the
        # firmware platform profile applies the mode itself. This
        # keeps the selected fan mode from being overwritten a moment later.
        ppd_profile = {"Quiet": "power-saver", "Balanced": "balanced", "Performance": "performance"}.get(name)
        applied = False
        bus = system_bus()
        if bus is not None and ppd_profile is not None:
            try:
                # power-profiles-daemon has no SetActiveProfile method; the
                # supported way to switch is the ActiveProfile D-Bus property.
                bus.call_sync(PPD_NAME, PPD_PATH, "org.freedesktop.DBus.Properties", "Set",
                              GLib.Variant("(ssv)", (PPD_IFACE, "ActiveProfile", GLib.Variant("s", ppd_profile))), None,
                              Gio.DBusCallFlags.NONE, 5000, None)
                applied = True
            except GLib.Error:
                applied = False
        if not applied:
            result = command(["asusctl", "profile", "set", name])
            if result.returncode != 0:
                ok = set_prop("PlatformProfile", GLib.Variant("u", PROFILE_IDS[name]))
                if not ok:
                    self.toast(f"Could not select {name}: {(result.stderr or result.stdout).strip() or 'asusd unavailable'}")
                    self.refresh()
                    return
        # The firmware takes up to ~1s to report the new profile; highlight the
        # requested card now and confirm after the change has propagated.
        self.pending_profile = name
        self.update_profile_styles(name)
        self.refresh()
        GLib.timeout_add(1500, self.verify_profile, name)

    def verify_profile(self, name):
        self.pending_profile = None
        self.refresh()
        current = read_profile()
        if current == name:
            self.toast(f"{name} mode selected · ASUS firmware confirmed")
        else:
            self.toast(f"Requested {name}; system currently reports {current}")
        return False

    def on_apply_limit(self, _button):
        value = round(self.limit_scale.get_value())
        result = command(["asusctl", "battery", "limit", str(value)])
        if result.returncode != 0:
            ok = set_prop("ChargeControlEndThreshold", GLib.Variant("y", value))
            if not ok:
                error = (result.stderr or result.stdout).strip() or "asusd unavailable"
                self.limit_dirty = False
                self.limit_feedback.set_text(f"Apply failed: {error}")
                self.toast("Could not apply battery limit")
                return
        confirmed = read_limit()
        self.limit_dirty = False
        self.refresh()
        if confirmed == value:
            self.limit_feedback.set_text(f"Applied and verified: stop charging at {value}%.")
            self.toast(f"Battery limit applied · {value}% verified")
        else:
            self.limit_feedback.set_text(f"Requested {value}%; system reports {confirmed if confirmed is not None else 'no value'}. Please refresh or inspect asusd.")
            self.toast("Battery limit did not verify — see status below")

    def on_limit_changed(self, _scale):
        if getattr(self, "syncing_limit", False):
            return
        self.limit_dirty = True
        self.limit_feedback.set_text(f"New target: {round(self.limit_scale.get_value())}% · press Apply to save")

    def on_oneshot(self, _button):
        result = command(["asusctl", "battery", "oneshot"])
        if result.returncode == 0:
            self.toast("One-time full charge requested")
        else:
            self.toast("Could not request full charge: " + ((result.stderr or result.stdout).strip() or "asusctl unavailable"))

    def on_effect_selected(self, _dropdown, _pspec):
        names = list(EFFECT_OPTIONS)
        spec = EFFECT_OPTIONS[names[self.effect_dropdown.get_selected()]]
        self.colour1_row.set_visible(spec.get("colours", 0) >= 1)
        self.colour2_row.set_visible(spec.get("colours", 0) >= 2)
        self.speed_row.set_visible(bool(spec.get("speed")))
        self.direction_row.set_visible(bool(spec.get("direction")))

    def selected_colour(self, widget, name_of_dark="101820"):
        if self.use_colour_dialog:
            return rgba_hex(widget.get_rgba())
        preset = list(AURA_PRESETS)[widget.get_selected()]
        if preset == "Dark":
            return name_of_dark
        return AURA_PRESETS[preset]

    def on_apply_effect(self, _button):
        names = list(EFFECT_OPTIONS)
        idx = self.effect_dropdown.get_selected()
        if idx >= len(names):
            return
        effect = names[idx]
        spec = EFFECT_OPTIONS[effect]
        args = ["asusctl", "aura", "effect", effect]
        if spec.get("colours", 0) >= 1:
            args += ["--colour", self.selected_colour(self.colour1, AURA_DEFAULT_COLOUR)]
        if spec.get("colours", 0) >= 2:
            args += ["--colour2", self.selected_colour(self.colour2)]
        if spec.get("speed"):
            args += ["--speed", AURA_SPEEDS[self.speed_dropdown.get_selected()]]
        if spec.get("direction"):
            args += ["--direction", AURA_DIRECTIONS[self.direction_dropdown.get_selected()]]
        result = command(args)
        if result.returncode == 0:
            self.toast(f"Keyboard effect set to {effect}")
        else:
            self.toast("Could not apply effect: " + ((result.stderr or result.stdout).strip() or "asusctl error"))

    def on_apply_brightness(self, _button):
        value = round(self.brightness_scale.get_value())
        level = {0: "off", 1: "low", 2: "med", 3: "high"}.get(value)
        if level is None:
            return
        result = command(["asusctl", "leds", "set", level])
        if result.returncode == 0:
            self.toast(f"Keyboard backlight set to {level}")
        else:
            self.toast("Could not set backlight: " + ((result.stderr or result.stdout).strip() or "asusctl error"))

    def on_request_gpu(self, _button):
        idx = self.gpu_dropdown.get_selected()
        if idx >= len(GPU_MODES):
            return
        mode = GPU_MODES[idx]
        current = self.gpu_current_value.get_text().strip()
        if current == mode:
            self.toast(f"{mode} mode is already active")
            return
        dialog = Adw.AlertDialog(heading="Change GPU mode?", body=f"Switch to {mode}? A logout or reboot is needed before the change takes effect.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("apply", "Change mode")
        dialog.set_response_appearance("apply", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.connect("response", self.on_gpu_response, mode)
        dialog.present(self)

    def on_gpu_response(self, _dialog, response, mode):
        if response != "apply":
            return
        result = command(["supergfxctl", "-m", mode])
        if result.returncode == 0:
            self.toast(f"{mode} requested · log out or reboot to complete")
            self.refresh()
        else:
            self.toast("GPU mode change failed: " + ((result.stderr or result.stdout).strip() or "supergfxctl error"))


class ArmouryApplication(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.connect("activate", self.on_activate)

    def on_activate(self, _app):
        win = self.get_active_window()
        if win is None:
            win = ArmouryWindow(self)
        win.present()


def main():
    GLib.set_application_name("Armoury Crate")
    Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    # USER priority (8000) is required: libadwaita's own button:checked and
    # scale/highlight rules out-rank app CSS at APPLICATION priority.
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    return ArmouryApplication().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
