def text(path, default="—"):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip() or default
    except OSError:
        return default


def int_or_none(v):
    try:
        return int(v)
    except (ValueError, TypeError):
        return None


def command(args, timeout=12):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        return subprocess.CompletedProcess(args, 127, "", str(e))


def system_bus():
    global BUS
    if BUS is None:
        try:
            BUS = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            return None
    return BUS


def get_prop(name):
    bus = system_bus()
    if bus is None:
        return None
    try:
        result = bus.call_sync(
            ASUSD_NAME, ASUSD_PATH, "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", (PLATFORM_IFACE, name)),
            GLib.VariantType.new("(v)"), Gio.DBusCallFlags.NONE, 4000, None)
        return result.unpack()[0]
    except GLib.Error:
        return None


def set_prop(name, variant):
    bus = system_bus()
    if bus is None:
        return False
    try:
        bus.call_sync(
            ASUSD_NAME, ASUSD_PATH, "org.freedesktop.DBus.Properties", "Set",
            GLib.Variant("(ssv)", (PLATFORM_IFACE, name, variant)), None,
            Gio.DBusCallFlags.NONE, 5000, None)
        return True
    except GLib.Error:
        return False


def read_profile():
    value = int_or_none(get_prop("PlatformProfile"))
    if value is not None:
        return PROFILE_VALUES.get(value, "Unknown")
    raw = text("/sys/firmware/acpi/platform_profile", "Unknown")
    return raw[:1].upper() + raw[1:]


def read_limit():
    value = int_or_none(get_prop("ChargeControlEndThreshold"))
    if value is not None:
        return value
    for path in BATTERY_PATHS:
        value = int_or_none(text(path, ""))
        if value is not None:
            return value
    return None


def fan_hwmon():
    for path in glob.glob("/sys/devices/platform/asus-nb-wmi/hwmon/hwmon*"):
        if os.path.exists(os.path.join(path, "fan1_input")):
            return path
    return None


def fan_read(path, file):
    return int_or_none(text(os.path.join(path, file), "")) if path else None


def rpm(value):
    return f"{value:,} rpm" if value is not None else "—"


def label(value, css=None):
    w = Gtk.Label(label=value, xalign=0, wrap=True)
    if css:
        w.add_css_class(css)
    # Short kickers/titles were inflating box min-size via wrapping; never wrap them.
    if css in ("surface-title", "eyebrow", "info-key", "opt-key", "footer",
               "brand-title", "brand-subtitle", "header-title", "hero-tag", "status-dot"):
        w.set_wrap(False)
    return w


def asus_image(filename, fallback_icon=None, size=18):
    """ASUS artwork from the Armoury Crate bundle, or a themed symbolic icon."""
    img = None
    if filename:
        path = os.path.join(ASSET_DIR, filename)
        if os.path.isfile(path):
            try:
                img = Gtk.Image.new_from_file(path)
            except Exception:
                img = None
    if img is None and fallback_icon:
        img = Gtk.Image.new_from_icon_name(fallback_icon)
    if img is None:
        return None
    img.set_pixel_size(size)
    img.add_css_class("info-icon")
    return img


def rgba_hex(rgba):
    return "%02x%02x%02x" % (round(rgba.red * 255) % 256, round(rgba.green * 255) % 256, round(rgba.blue * 255) % 256)


def make_rgba(hex_colour):
    rgba = Gdk.RGBA()
    try:
        rgba.parse("#" + hex_colour)
    except TypeError:
        rgba = Gdk.RGBA.parse("#" + hex_colour)
    return rgba


def read_memory():
    total = available = None
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    available = int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return total, available


def read_disks():
    """Physical storage devices (skips loop/zram/ram devices)."""
    disks = []
    try:
        for dev in sorted(os.listdir("/sys/block")):
            if dev.startswith(("loop", "ram", "zram", "fd", "sr", "dm-")):
                continue
            model = text(f"/sys/block/{dev}/device/model", "").strip()
            sectors = int_or_none(text(f"/sys/block/{dev}/size", ""))
            if not sectors:
                continue
            gb = sectors * 512 / 1e9
            disks.append(f"{gb:.1f} GB".rstrip("0").rstrip(".") + (" · " + model if model else f" · {dev}"))
    except OSError:
        pass
    return disks


def pretty_product_name(raw):
    name = raw.strip()
    # "ASUS TUF Gaming A15 FA506IHRB_FA506IHRB" → "ASUS TUF Gaming A15 FA506IHRB"
    if "_" in name:
        prefix, suffix = name.rsplit("_", 1)
        if prefix.endswith(suffix):
            name = prefix
    return name


def read_thermal(hwmon_name):
    """Temperature (°C) from the first temp1_input of a matching hwmon chip."""
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(path, "name"), encoding="utf-8") as f:
                if f.read().strip() != hwmon_name:
                    continue
        except OSError:
            continue
        value = int_or_none(text(os.path.join(path, "temp1_input"), ""))
        if value is not None:
            return value / 1000.0
    return None


def cpu_freq_ghz():
    total = count = 0.0
    try:
        with open("/proc/cpuinfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("cpu MHz"):
                    total += float(line.split(":", 1)[1])
                    count += 1
    except (OSError, ValueError, IndexError):
        return 0.0
    return total / count / 1000 if count else 0.0


def cpu_model():
    try:
        with open("/proc/cpuinfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except (OSError, IndexError):
        pass
    return "Processor"


def disk_usage(path="/"):
    """(total GB, free GB, percent used) for a filesystem."""
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize / 1e9
        free = st.f_bavail * st.f_frsize / 1e9
        used_pct = (total - free) / total * 100 if total else 0.0
        return total, free, used_pct
    except OSError:
        return 0.0, 0.0, 0.0


_gpu_names = None


def gpu_names():
    """(dGPU description, iGPU description) from lspci; cached."""
    global _gpu_names
    if _gpu_names is None:
        dgpu = igpu = "Integrated graphics"
        result = command(["lspci"])
        if result.returncode == 0:
            for line in result.stdout.splitlines():
                low = line.lower()
                if ("vga" in low or "3d controller" in low or "display controller" in low) and ":" in line:
                    desc = line.split(":", 2)[-1].strip()
                    if "[" in desc and "]" in desc:
                        # "NVIDIA Corporation TU117M [GeForce GTX 1650 Mobile / Max-Q]"
                        desc = desc[desc.index("[") + 1:desc.index("]")]
                    desc = desc.split(" (rev ")[0]
                    if "nvidia" in low:
                        dgpu = desc
                    elif "amd" in low or "ati" in low:
                        igpu = desc
        _gpu_names = (dgpu, igpu)
    return _gpu_names


def os_pretty_name():
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "Unknown Linux"


def card(title, value, detail=""):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.add_css_class("surface")
    box.append(label(title.upper(), "surface-title"))
    val = label(value, "surface-value")
    box.append(val)
    if detail:
        box.append(label(detail, "subtle"))
    return box, val


def page_heading(kicker, title, subtitle):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    if kicker:
        box.append(label(kicker.upper(), "eyebrow"))
    box.append(label(title, "page-title"))
    if subtitle:
        box.append(label(subtitle, "subtle"))
    box.set_margin_bottom(16)
    return box


